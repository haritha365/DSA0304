sentence = input("Enter a sentence: ").lower().split()

if len(sentence) >= 2:
    subject = sentence[0]
    verb = sentence[1]

    if subject in ["he", "she", "it"] and verb.endswith("s"):
        print("Sentence is grammatically correct.")
    elif subject in ["i", "we", "you", "they"] and not verb.endswith("s"):
        print("Sentence is grammatically correct.")
    else:
        print("Subject-Verb Agreement Error!")
else:
    print("Invalid sentence.")
