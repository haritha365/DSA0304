from collections import Counter

# Training corpus
corpus = """
the student is intelligent
the student is hardworking
the student studies computer science
the student likes programming
the teacher is intelligent
the teacher teaches computer science
the teacher likes programming
the computer is fast
the computer is useful
students study programming
students study computer science
"""

# Preprocessing
sentences = [s.strip().lower().split() for s in corpus.strip().split("\n")]

# Add sentence boundaries
sentences = [["<s>"] + s + ["</s>"] for s in sentences]

# Count N-grams
unigram = Counter()
bigram = Counter()
trigram = Counter()

for sentence in sentences:
    unigram.update(sentence)

    for i in range(len(sentence) - 1):
        bigram[(sentence[i], sentence[i + 1])] += 1

    for i in range(len(sentence) - 2):
        trigram[(sentence[i], sentence[i + 1], sentence[i + 2])] += 1


# Probability functions
def unigram_probability(word):
    return unigram[word] / sum(unigram.values())


def bigram_probability(w1, w2):
    if unigram[w1] == 0:
        return 0
    return bigram[(w1, w2)] / unigram[w1]


def trigram_probability(w1, w2, w3):
    if bigram[(w1, w2)] == 0:
        return 0
    return trigram[(w1, w2, w3)] / bigram[(w1, w2)]


# Display model
def display_model(n):
    print("\nN =", n)

    if n == 1:
        for word, count in unigram.items():
            print(word, "Count =", count,
                  "Probability =", round(unigram_probability(word), 4))

    elif n == 2:
        for pair, count in bigram.items():
            p = bigram_probability(pair[0], pair[1])
            print(pair, "Count =", count,
                  "Probability =", round(p, 4))

    elif n == 3:
        for triple, count in trigram.items():
            p = trigram_probability(triple[0], triple[1], triple[2])
            print(triple, "Count =", count,
                  "Probability =", round(p, 4))


# Prediction
def predict(sentence, n):
    words = sentence.lower().split()
    predictions = []

    if n == 1:
        for word in unigram:
            predictions.append((word, unigram_probability(word)))

    elif n == 2:
        last = words[-1]

        for word in unigram:
            p = bigram_probability(last, word)
            if p > 0:
                predictions.append((word, p))

    elif n == 3:
        if len(words) < 2:
            return []

        w1, w2 = words[-2], words[-1]

        for word in unigram:
            p = trigram_probability(w1, w2, word)
            if p > 0:
                predictions.append((word, p))

    predictions.sort(key=lambda x: x[1], reverse=True)
    return predictions[:5]


# Main
n = int(input("Enter N (1, 2 or 3): "))
display_model(n)

query = input("\nEnter incomplete sentence: ")

print("\nTop-5 next-word predictions:")
result = predict(query, n)

if result:
    for word, probability in result:
        print(word, "->", round(probability, 4))
else:
    print("No prediction available. Probability = 0")


# Demonstrate unseen N-gram
print("\nUnseen N-gram example:")
print("P(student | computer) =",
      bigram_probability("computer", "student"))
